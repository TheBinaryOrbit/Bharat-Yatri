NODE_ENV=development
PORT=5000

# Public base URL used to build uploaded-file links (optional; falls back to request host)
BASE_URL=http://localhost:5000

# MongoDB connection string
MONGO_URI=mongodb://127.0.0.1:27017/bharat_yatri

# JWT
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# 2factor.in OTP
OTP_KEY=your_2factor_api_key
OTP_DIGIT_LENGTH=6

# Admin gate — secret for admin-only endpoints (sent as x-admin-key header)
ADMIN_API_KEY=change_this_admin_key

# Signzy DigiLocker KYC
SIGNZY_BASE_URL=https://signzy.example.com
SIGNZY_API_KEY=your_signzy_api_key
# Public base host Signzy calls back to; the API path + driverId are appended in code
# e.g. https://your-public-host  ->  https://your-public-host/api/v3/drivers/kyc/callback/<driverId>
SIGNZY_CALLBACK_URL=https://your-public-host
SIGNZY_SUCCESS_URL=https://your-app/kyc-success
SIGNZY_FAILURE_URL=https://your-app/kyc-failure

# Redis — driver location GEO index (required for QuickRide dispatch)
REDIS_URL=redis://127.0.0.1:6379

# Google Distance Matrix — ride distance/duration estimates (required, server won't boot without it)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Zone a bare YYYY-MM-DD date filter is interpreted in, as minutes ahead of UTC (330 = IST)
APP_UTC_OFFSET_MINUTES=330

# QuickRide lifecycle
MAX_RIDE_DISTANCE_KM=100
RIDE_PENDING_TTL_SECONDS=300
BID_TTL_SECONDS=60
EXPIRY_SWEEP_INTERVAL_MS=5000

# Driver discovery — rings widen from START to MAX until drivers are found
DRIVER_SEARCH_RADIUS_START_KM=2
DRIVER_SEARCH_RADIUS_MAX_KM=10
DRIVER_SEARCH_RADIUS_STEP_KM=2
# Liveness window for a driver's location; the app pings every 5s
DRIVER_LOCATION_TTL_SECONDS=30

# Grace window after a socket drops before the driver's Redis entry is discarded
DRIVER_DISCONNECT_GRACE_SECONDS=300

# Rider offer band, as multipliers of the suggested fare (how far the rider may nudge the suggestion)
OFFER_MIN_MULTIPLIER=0.8
OFFER_MAX_MULTIPLIER=1.5

# Bid fare band, as multipliers of the rider's offered fare
BID_MIN_MULTIPLIER=0.8
BID_MAX_MULTIPLIER=1.5

# Ride start OTP (separate from OTP_DIGIT_LENGTH, which is the phone-login OTP)
RIDE_START_OTP_LENGTH=4
RIDE_START_OTP_MAX_ATTEMPTS=5

# Location fixes implying a faster jump than this are dropped as bad GPS
MAX_LOCATION_JUMP_KMPH=200

# Front-end base for the shareable live-tracking link
TRACKING_LINK_BASE_URL=https://track.bharatyatri.com
