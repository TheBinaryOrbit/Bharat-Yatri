NODE_ENV=development
PORT=5000

# Public base URL used to build uploaded-file links (optional; falls back to request host)
BASE_URL=http://localhost:5000

# MongoDB connection string
MONGO_URI=mongodb://127.0.0.1:27017/bharat_yatri

# JWT
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# 2factor.in OTP
OTP_KEY=your_2factor_api_key
OTP_DIGIT_LENGTH=6

# Admin gate — secret for admin-only endpoints (sent as x-admin-key header)
ADMIN_API_KEY=change_this_admin_key

# Signzy DigiLocker KYC
SIGNZY_BASE_URL=https://signzy.example.com
SIGNZY_API_KEY=your_signzy_api_key
# Public base host Signzy calls back to; the API path + driverId are appended in code
# e.g. https://your-public-host  ->  https://your-public-host/api/v3/drivers/kyc/callback/<driverId>
SIGNZY_CALLBACK_URL=https://your-public-host
SIGNZY_SUCCESS_URL=https://your-app/kyc-success
SIGNZY_FAILURE_URL=https://your-app/kyc-failure
